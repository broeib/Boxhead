      if(mode !== undefined && mode !== "three-pose-v2" && mode !== "four-pose-v3") return {version:1,ok:false};
      if(enabled && (b.active || b.state != "menu")) return {version:1,ok:false};
      if(!enabled) this.BH_PresentationDispose();
      b.presentationRequested = enabled;
