      var p = this.mBH.presentation;
      if(p == undefined || (world !== undefined && p.world !== world)) return;
      p.capturing = false;
      // Restore the original bitmap at its original depth, leaving HUD order.
      if(p.attached) p.world.attachBitmap(p.records[0].target,p.depth,"always",false);
      for(var i = 0; i < p.records.length; i++)
      {
         var record = p.records[i];
         for(var name in record.methods)
         {
            var method = record.methods[name];
            if(record.target[name] === method.wrapper)
            {
               if(method.own) record.target[name] = method.original;
               else delete record.target[name];
            }
         }
         record.display.dispose();
      }
      for(var n = 0; n < p.scratch.length; n++) p.scratch[n].dispose();
      if(p.mode === "three-pose-v2" || p.mode === "four-pose-v3")
      {
         // No old maps, command arguments or scratch pixels survive this owner.
         if(p.mode === "four-pose-v3") delete p.oldest;
         delete p.older;
         delete p.previous;
         delete p.anchors;
         p.commands = new Array();
         p.scratch = new Array();
      }
      delete this.mBH.presentation;
      updateAfterEvent();
   }
