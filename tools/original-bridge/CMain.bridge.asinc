   var mBH;

   function BH_Install()
   {
      this.mBH = {active:false,state:"menu",tick:0,clock:0,error:"",stepping:false,cache:false,logicCalls:0,drawCalls:0,seed:1,rng:1,rngCalls:0,cacheRng:104730,cacheCalls:0,snapshotReceiptEpoch:0,snapshotReceiptBusy:false};
      this.BH_NativeScalarInstall();
      this.BH_NativeProjectionInstall();
      this.BH_NativeProjectInstall();
      if(!flash.external.ExternalInterface.available)
      {
         return;
      }
      var ok = flash.external.ExternalInterface.addCallback("bhInfo",this,this.BH_ReceiptGuard("bhInfo",this.BH_Info));
      ok = flash.external.ExternalInterface.addCallback("bhPrepare",this,this.BH_ReceiptGuard("bhPrepare",this.BH_Prepare)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStep",this,this.BH_ReceiptGuard("bhStep",this.BH_Step)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhState",this,this.BH_ReceiptGuard("bhState",this.BH_ReadState)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStateReceipt",this,this.BH_ReceiptGuard("bhStateReceipt",this.BH_StagedStateReceipt)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhCheckpointExport",this,this.BH_ReceiptGuard("bhCheckpointExport",this.BH_CheckpointExport)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhCheckpointImport",this,this.BH_ReceiptGuard("bhCheckpointImport",this.BH_CheckpointImport)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhMenuPoll",this,this.BH_ReceiptGuard("bhMenuPoll",this.BH_MenuPoll)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhMenuUpdate",this,this.BH_ReceiptGuard("bhMenuUpdate",this.BH_MenuUpdate)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhRenderCheck",this,this.BH_ReceiptGuard("bhRenderCheck",this.BH_RenderCheck)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhControls",this,this.BH_ReceiptGuard("bhControls",this.BH_Controls)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhAnimationProbe",this,this.BH_ReceiptGuard("bhAnimationProbe",this.BH_AnimationProbe)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhPresentationConfig",this,this.BH_ReceiptGuard("bhPresentationConfig",this.BH_PresentationConfig)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhPresent",this,this.BH_ReceiptGuard("bhPresent",this.BH_Present)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhPresentationInfo",this,this.BH_ReceiptGuard("bhPresentationInfo",this.BH_PresentationInfo)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStepBegin",this,this.BH_ReceiptGuard("bhStepBegin",this.BH_StagedStepBegin)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStepPrepare",this,this.BH_ReceiptGuard("bhStepPrepare",this.BH_StagedStepPrepare)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStepProject",this,this.BH_ReceiptGuard("bhStepProject",this.BH_StagedStepProject)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStepCommit",this,this.BH_ReceiptGuard("bhStepCommit",this.BH_StagedStepCommit)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhStepAbort",this,this.BH_ReceiptGuard("bhStepAbort",this.BH_StagedStepAbort)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhFrameBegin",this,this.BH_ReceiptGuard("bhFrameBegin",this.BH_CompactFrameBegin)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhFrameCommit",this,this.BH_ReceiptGuard("bhFrameCommit",this.BH_CompactFrameCommit)) && ok;
      ok = flash.external.ExternalInterface.addCallback("bhFrameAbort",this,this.BH_ReceiptGuard("bhFrameAbort",this.BH_CompactFrameAbort)) && ok;
      if(!ok)
      {
         this.mBH.state = "error";
         this.mBH.error = "ExternalInterface callback registration failed";
      }
      else this.BH_StagedInstall();
      if(ok && this.mBH.state != "error") this.BH_CompactInstall();
   }

   // Ruffle permits an ExternalInterface call to reenter AVM1 synchronously.
   // Wrap only exported callbacks: internal BH_Info/BH_State calls stay direct.
   function BH_ReceiptGuard(name, callback)
   {
      if(typeof callback != "function") return undefined;
      var owner = this;
      return function()
      {
         if(owner.mBH.snapshotReceiptBusy === true)
            return owner.BH_ReceiptPoison("reentrant ExternalInterface callback: " + name);
         if(owner.mBHCompactStep !== undefined)
            return owner.BH_CompactDispatch(name,callback,arguments);
         if(owner.mBHStagedStep !== undefined)
            return owner.BH_StagedDispatch(name,callback,arguments);
         return callback.apply(owner,arguments);
      };
   }

   function BH_ReceiptPoison(message)
   {
      var b = this.mBH;
      b.snapshotReceiptPoisoned = true;
      b.state = "error";
      if(b.error == "") b.error = String(message);
      delete b.snapshotReceiptRequest;
      delete b.snapshotReceiptProof;
      delete b.snapshotReceiptPending;
      // Do not call the public/info adapter while its outer digest is active.
      return {version:1,engine:"original-swf",state:"error",tick:b.tick,error:b.error,snapshotReceiptVersion:1};
   }

   function BH_ReceiptDigest(native)
   {
      var b = this.mBH;
      var request = b.snapshotReceiptRequest;
      if(request === undefined || request.used === true || b.snapshotReceiptBusy === true
         || b.snapshotReceiptProof !== undefined || b.snapshotReceiptPending !== undefined
         || b.stepping || b.state != "playing" || b.tick !== request.tick
         || native.tick !== request.tick || (native.scope != "frame" && native.scope != "full"))
      {
         this.BH_ReceiptPoison("invalid native snapshot receipt transaction");
         throw new Error("invalid native snapshot receipt transaction");
      }
      var world = this.mcWorld;
      var metadata = {version:1,token:request.token,epoch:request.epoch,tick:request.tick,scope:native.scope};
      request.used = true;
      b.snapshotReceiptBusy = true;
      b.snapshotReceiptPoisoned = false;
      try
      {
         // The graph is the exact freshly built projection. Its canonical
         // digest input and the legacy callback's first argument do not change.
         var fast = flash.external.ExternalInterface.call("boxheadDigestOriginalState",native,metadata);
         if(this.mBH !== b || this.mcWorld !== world || b.snapshotReceiptPoisoned === true
            || b.snapshotReceiptBusy !== true || b.state == "error"
            || b.snapshotReceiptRequest !== request || b.tick !== request.tick)
            throw new Error("native snapshot receipt transaction was reentered or replaced");
         var proof = fast.receipt;
         if(typeof proof != "object" || proof === null || proof instanceof Array
            || !proof.hasOwnProperty("version") || !proof.hasOwnProperty("token")
            || !proof.hasOwnProperty("epoch") || !proof.hasOwnProperty("tick") || !proof.hasOwnProperty("scope")
            || proof.version !== 1 || proof.token !== request.token || proof.epoch !== request.epoch
            || proof.tick !== request.tick || proof.scope !== native.scope
            || typeof fast.digest != "string" || fast.digest.length != 26 || fast.digest.substr(0,10) != "native-v2-"
            || !CMain.BH_Integer(fast.bytes,0,8000000))
            throw new Error("canonical native digest receipt unavailable or mismatched");
         for(var key in proof)
            if(key != "version" && key != "token" && key != "epoch" && key != "tick" && key != "scope")
               throw new Error("unknown canonical native digest receipt field");
         b.snapshotReceiptProof = {request:request,native:native,digest:fast.digest,bytes:fast.bytes,scope:native.scope};
         return fast;
      }
      catch(e)
      {
         this.BH_ReceiptPoison("native snapshot receipt digest: " + String(e));
         throw e;
      }
      finally
      {
         b.snapshotReceiptBusy = false;
      }
   }

   function BH_ReceiptPublish(snapshot, token)
   {
      var b = this.mBH;
      var request = b.snapshotReceiptRequest;
      var proof = b.snapshotReceiptProof;
      if(request === undefined || proof === undefined || proof.request !== request || request.used !== true
         || b.snapshotReceiptBusy === true || b.snapshotReceiptPoisoned === true || b.stepping || b.state != "playing"
         || b.snapshotReceiptPending !== undefined || request.token !== token || request.epoch !== b.snapshotReceiptEpoch
         || b.tick !== request.tick || b.snapshot !== snapshot || snapshot.tick !== request.tick
         || snapshot.state !== b.state || snapshot.scope !== proof.scope || snapshot.native !== proof.native
         || snapshot.entities !== proof.native.entities || snapshot.digest !== proof.digest || snapshot.snapshotBytes !== proof.bytes)
         throw new Error("native snapshot receipt publication does not match its captured graph");
      b.snapshotReceiptPending = {token:request.token,epoch:request.epoch,tick:request.tick,scope:proof.scope,
         snapshot:snapshot,native:proof.native,digest:proof.digest,bytes:proof.bytes};
      delete b.snapshotReceiptRequest;
      delete b.snapshotReceiptProof;
   }

   function BH_StateReceipt(token, epoch, tick)
   {
      var b = this.mBH;
      var pending = b.snapshotReceiptPending;
      // Every attempt consumes the lease. A wrong read cannot be retried into
      // a valid ACK, and a later step must never replace unconsumed evidence.
      delete b.snapshotReceiptPending;
      if(b.snapshotReceiptBusy === true) return this.BH_ReceiptPoison("reentrant native snapshot receipt read");
      if(pending === undefined || !CMain.BH_ValidLink(token) || !CMain.BH_Integer(epoch,1,2147483647)
         || !CMain.BH_Integer(tick,1,2147483647) || token !== pending.token || epoch !== pending.epoch || tick !== pending.tick
         || !b.active || b.state != "playing" || b.stepping || b.snapshotReceiptPoisoned === true
         || b.snapshotReceiptRequest !== undefined || b.snapshotReceiptProof !== undefined
         || b.snapshotReceiptEpoch !== epoch || b.tick !== tick || b.snapshot !== pending.snapshot)
         return this.BH_Fail("native snapshot receipt is absent, consumed, stale, or mismatched");
      var snapshot = pending.snapshot;
      if(snapshot.native !== pending.native || snapshot.entities !== pending.native.entities
         || snapshot.tick !== tick || snapshot.scope !== pending.scope || snapshot.state !== b.state
         || snapshot.digest !== pending.digest || snapshot.snapshotBytes !== pending.bytes
         || pending.native.tick !== tick || pending.native.scope !== pending.scope)
         return this.BH_Fail("native snapshot receipt identity changed before readback");
      var header = new Object();
      for(var key in snapshot)
         if(key != "native" && key != "entities" && snapshot.hasOwnProperty(key)) header[key] = snapshot[key];
      return {version:1,token:pending.token,epoch:pending.epoch,tick:pending.tick,scope:pending.scope,header:header};
   }

   static function BH_Active()
   {
      return CMain._this.mBH.active == true;
   }

   static function BH_Timer()
   {
      var b = CMain._this.mBH;
      if(!b.active || b.cache || b.complete != undefined)
      {
         return getTimer();
      }
      return b.clock;
   }

   static function BH_Seed()
   {
      return !CMain.BH_Active() ? 0 : CMain._this.mBH.seed;
   }

   static function BH_Float()
   {
      var b = CMain._this.mBH;
      if(!b.active)
      {
         return Math.random();
      }
      if(b.complete != undefined) return CMain.BH_AudioFloat();
      if(b.cache)
      {
         b.cacheRng = b.cacheRng * 16807 % 2147483647;
         b.cacheCalls++;
         return (b.cacheRng - 1) / 2147483646;
      }
      if((b.state == "ready" || b.state == "playing") && !b.stepping)
      {
         CMain._this.BH_Fail("random call outside commanded frame");
         return 0;
      }
      b.rng = b.rng * 16807 % 2147483647;
      b.rngCalls++;
      return (b.rng - 1) / 2147483646;
   }

   static function BH_Random(n)
   {
      if(!CMain.BH_Active())
      {
         return random(n);
      }
      n = Number(n) >> 0;
      if(n <= 0)
      {
         return 0;
      }
      return Math.floor(CMain.BH_Float() * n);
   }


   static function BH_AudioFloat()
   {
      var b = CMain._this.mBH;
      if(!b.active) return Math.random();
      b.audioRng = b.audioRng * 16807 % 2147483647;
      return (b.audioRng - 1) / 2147483646;
   }

   static function BH_AudioRandom(n)
   {
      if(!CMain.BH_Active()) return random(n);
      n = Number(n) >> 0;
      return n <= 0 ? 0 : Math.floor(CMain.BH_AudioFloat() * n);
   }

   static function BH_AudioTimer()
   {
      return getTimer();
   }

   static function BH_RenderStackProcess(start, budget)
   {
      var b = CMain._this.mBH;
      if(!b.active)
      {
         return DrawPrimitive.XSI.CDrawPrimitive_XSI_DI.RenderStack_Process(start,budget);
      }
      var previous = b.cache;
      b.cache = true;
      var result;
      try
      {
         result = DrawPrimitive.XSI.CDrawPrimitive_XSI_DI.RenderStack_Process(getTimer(),budget);
      }
      catch(e)
      {
         b.cache = previous;
         CMain._this.BH_Fail("render cache exception: " + String(e));
         throw e;
      }
      b.cache = previous;
      return result;
   }

   static function BH_EnterWorld(kind)
   {
      if(!CMain.BH_Active())
      {
         return true;
      }
      var b = CMain._this.mBH;
      if(!b.stepping)
      {
         CMain._this.BH_Fail("unscheduled world " + kind);
         return false;
      }
      if(kind == "logic")
      {
         b.logicCalls++;
      }
      else
      {
         b.drawCalls++;
      }
      return true;
   }

   function BH_Fail(message)
   {
      this.mBH.state = "error";
      this.mBH.error = String(message);
      delete this.mBH.snapshotReceiptRequest;
      delete this.mBH.snapshotReceiptProof;
      delete this.mBH.snapshotReceiptPending;
      return this.BH_Info();
   }

   function BH_Info()
   {
      var b = this.mBH;
      var result = {version:1,menuVersion:1,menuScreen:this.mcScreen.idScreen,menuReady:this.mcScreen.idScreen == "Screen_Main" && this.mcScreen.mNormal,menuState:b.menuMode,menuBounds:this.BH_MenuBounds(),engine:"original-swf",state:b.state,tick:b.tick,qualified:false,digestSchema:"native-projection-v3",snapshotReceiptVersion:1,canPrepare:!b.active && CMain.mInput != undefined && this.mcWorld == undefined && CMain.mInitBGTasks};
      result.presentationVersion = 1;
      // A loading-time snapshot; no native metadata query is made per Info/frame.
      if(b.anchorMetadataStats !== undefined) result.anchorMetadata = b.anchorMetadataStats;
      if(b.stagedStepVersion === 1 && b.replay !== true) result.stagedStepVersion = 1;
      if(b.compactStepVersion === 1 && b.stagedStepVersion === 1 && b.state != "error" && b.replay !== true) result.compactStepVersion = 1;
      if(this.BH_CheckpointAvailable()) result.checkpointVersion = 1;
      if(b.nativeScalarKernel !== undefined)
      {
         try { result.nativeScalarKernel = CMain.BH_NativeScalarInfo(b.nativeScalarKernel); }
         catch(e) { return this.BH_ReceiptPoison("native scalar witness failed: " + String(e)); }
      }
      if(b.nativeProjectionScanKernel !== undefined)
      {
         try { result.nativeProjectionScan = CMain.BH_NativeProjectionInfo(b.nativeProjectionScanKernel); }
         catch(e) { return this.BH_ReceiptPoison("native projection witness failed: " + String(e)); }
      }
      if(b.nativeProjectKernel !== undefined)
      {
         try { result.nativeProject = CMain.BH_NativeProjectInfo(b.nativeProjectKernel); }
         catch(e) { return this.BH_ReceiptPoison("native project witness failed: " + String(e)); }
      }
      if(b.active && b.tick == 0 && (b.state == "loading" || b.state == "error"))
      {
         var w = this.mcWorld;
         var phase = "waiting-for-world";
         if(w != undefined)
         {
            phase = w.onEnterFrame == w.Init ? "Init" :
               w.onEnterFrame == w.InitDrawPlanes ? "InitDrawPlanes" :
               w.onEnterFrame == w.InitThings ? "InitThings" :
               w.onEnterFrame == w.InitCleanUp ? "InitCleanUp" :
               w.onEnterFrame == w.InitFinished ? "InitFinished" : "finished";
         }
         result.loading = {elapsedMs:getTimer() - b.started,phase:phase,loaded:w.mLoaded == true,renderQueue:DrawPrimitive.XSI.CDrawPrimitive_XSI_DI.mRenderStack.length,worldWidth:w.mArea.width,worldHeight:w.mArea.height,initObjects:w.mInitList.length};
      }
      if(b.error != "")
      {
         result.error = b.error;
      }
      if(b.complete != undefined)
      {
         result.complete = b.complete;
      }
      return result;
   }

   static function BH_Integer(value, low, high)
   {
      return typeof value == "number" && !isNaN(value) && isFinite(value) && Math.floor(value) == value && value >= low && value <= high;
   }

   static function BH_ValidLink(value)
   {
      if(typeof value != "string" || value.length < 1 || value.length > 100)
      {
         return false;
      }
      for(var i = 0; i < value.length; i++)
      {
         var c = value.charCodeAt(i);
         if(!((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95))
         {
            return false;
         }
      }
      return true;
   }

   function BH_Prepare(seed, mode, mapLink, p1Character, p2Character, settings, network)
   {
      var b = this.mBH;
      if(b.active)
      {
         return {version:1,engine:"original-swf",state:b.state,tick:b.tick,error:"prepare already accepted; reload SWF for another session"};
      }
      if(!CMain.BH_Integer(seed,0,4294967295) || (mode != "Coop" && mode != "DeathMatch") || !CMain.BH_ValidLink(mapLink) || !CMain.BH_Integer(p1Character,0,3) || !CMain.BH_Integer(p2Character,0,3))
      {
         return {version:1,engine:"original-swf",state:b.state,tick:b.tick,error:"invalid prepare arguments"};
      }
      if(CMain.mInput == undefined || this.mcWorld != undefined || !CMain.mInitBGTasks)
      {
         return {version:1,engine:"original-swf",state:b.state,tick:b.tick,error:"prepare requires initialized original menu without an existing world"};
      }
      if(b.state == "error")
      {
         return this.BH_Info();
      }

      var config = {difficulty:0,speed:1,devils:1,collisions:1,damage:1,gameAmount:1};
      var maxima = {difficulty:3,speed:2,devils:1,collisions:1,damage:1,gameAmount:3};
      if(settings != undefined)
      {
         if(typeof settings != "object" || settings == null || settings instanceof Array)
            return {error:"invalid game settings"};
         for(var setting in settings)
         {
            if(!config.hasOwnProperty(setting) || !CMain.BH_Integer(settings[setting],0,maxima[setting]))
               return {error:"invalid game setting: " + setting};
            config[setting] = settings[setting];
         }
      }

      var initialPlayers = 2;
      var personalProgression = false;
      var localSlot = 1;
      var replay = false;
      var membershipVersion = 0;
      if(network != undefined)
      {
         if(typeof network != "object" || network == null || network instanceof Array || !CMain.BH_Integer(network.initialPlayers,1,2) || typeof network.personalProgression != "boolean" || !CMain.BH_Integer(network.localSlot,1,2))
            return {error:"invalid online membership options"};
         for(var option in network)
            if(option != "initialPlayers" && option != "personalProgression" && option != "localSlot" && option != "replay" && option != "membershipVersion") return {error:"unknown online membership option"};
         if(network.replay != undefined && typeof network.replay != "boolean") return {error:"invalid historical presentation option"};
         initialPlayers = network.initialPlayers;
         personalProgression = network.personalProgression;
         localSlot = network.localSlot;
         replay = network.replay == true;
         if(network.membershipVersion != undefined && network.membershipVersion !== 1 && network.membershipVersion !== 2) return {error:"invalid membership version"};
         membershipVersion = network.membershipVersion == undefined ? 0 : network.membershipVersion;
         if(membershipVersion == 1 && (initialPlayers != 1 || !personalProgression || mode != "Coop"))
            return {error:"membership events require an initially solo personal Cooperative world"};
         // v2 preserves the original DeathMatch world and match score, or an
         // initially two-player personal Cooperative world, across departures.
         if(membershipVersion == 2 && (!personalProgression || (mode == "Coop" && initialPlayers != 2)))
            return {error:"invalid membership version 2 configuration"};
         if(replay && (localSlot != 2 || (membershipVersion != 2 && (initialPlayers != 1 || !personalProgression))))
            return {error:"historical presentation requires a joining solo-room guest"};
      }

      var music = CMain.mSaveData.mMusicActive;
      var sound = CMain.mSaveData.mSoundActive;
      this.BH_MenuRemove();
      b.active = true;
      b.state = "loading";
      delete b.anchorMetadataStats;
      b.tick = 0;
      b.clock = 0;
      b.seed = seed;
      b.rng = seed % 2147483646 + 1;
      b.cacheRng = (b.rng + 104729) % 2147483646 + 1;
      b.audioRng = (b.rng + 130363) % 2147483646 + 1;
      b.rngCalls = 0;
      b.cacheCalls = 0;
      b.started = getTimer();
      b.settings = config;
      b.frameMs = config.speed == 0 ? 80 : (config.speed == 2 ? 20 : 40);
      b.mode = mode;
      b.map = mapLink;
      b.characters = [p1Character,p2Character];
      b.initialPlayers = initialPlayers;
      b.playerCount = initialPlayers;
      b.personalProgression = personalProgression;
      b.localSlot = localSlot;
      b.replay = replay;
      b.membershipVersion = membershipVersion;
      b.guestGeneration = membershipVersion == 2 && initialPlayers == 2 ? 1 : 0;
      b.replayInstalled = false;
      b.replayRestored = false;
      b.replaySkipped = 0;
      b.replayTargets = new Array();
      try
      {
         CMain.mSaveData = new CSaveData();
         CMain.mSaveData._MusicActive = music;
         CMain.mSaveData._SoundActive = sound;
         CMain.mSaveData._Difficulty = config.difficulty;
         CMain.mSaveData._GameSpeed = config.speed;
         CMain.mSaveData._DevilsActive = config.devils;
         CMain.mSaveData._CollisionsActive = config.collisions;
         CMain.mSaveData._DamageActive = config.damage;
         CMain.mSaveData._GameAmount = config.gameAmount;
         Thing.Creature.CThing_Creature.mDamageActive = mode == "DeathMatch" ? true : Boolean(config.damage);
         CMain.mSaveData._Player1_CharacterIndex = p1Character;
         CMain.mSaveData._Player2_CharacterIndex = p2Character;
         _global.mDebug = false;
         _global.mCheatsActive = false;
         _global.mCheat_OneZombie = false;
         _global.mInfinateLife = false;
         _root._quality = "HIGH";
         CMain.mFPS = 25;
         World.CWorld.mGameMode = mode;
         World.CWorld.m2Player = initialPlayers == 2;
         CMain.mInput = new CInput();
         this.mWorldLibLink = mapLink;
         this.mReturn_SelectWorld = "State_SelectWorld_" + mode;
         if(initialPlayers == 1 || membershipVersion == 2)
         {
            // A joining character must never queue asset preparation mid-frame.
            for(var character = 0; character < 4; character++) Thing.Creature.CThing_Creature_Player.GetCollection(character);
         }
         else
         {
            Thing.Creature.CThing_Creature_Player.GetCollection(p1Character);
            Thing.Creature.CThing_Creature_Player.GetCollection(p2Character);
         }
         this.SetState("State_LoadWorld");
      }
      catch(e)
      {
         return this.BH_Fail("prepare exception: " + String(e));
      }
      return this.BH_Info();
   }

   function BH_Pump()
   {
      var b = this.mBH;
      if(this.mBHStagedStep !== undefined) return;
      if(this.mBHCompactStep !== undefined) return;
      if(b.complete != undefined && b.state != "error")
      {
         // The last native snapshot remains available after the original
         // debrief disposes the world; no more gameplay ticks are accepted.
         if((this.fState == this.State_Debrief || this.fState == this.State_Debrief_Winner) && (b.debriefAt == undefined || getTimer() - b.debriefAt >= 40))
         {
            b.debriefAt = getTimer();
            this.fState(true);
            CSound.ProcessAll();
            CMain.ProcessBGTasks();
         }
         return;
      }
      if(b.state != "loading")
      {
         return;
      }
      if(getTimer() - b.started > 180000)
      {
         this.BH_Fail("original world initialization timeout");
         return;
      }
      try
      {
         if(this.mcWorld.mCompleteState == "error")
         {
            this.BH_Fail("original world linkage failed");
            return;
         }
         if(this.fState != this.State_RunWorld)
         {
            this.fState(true);
            CSound.ProcessAll();
            CMain.ProcessBGTasks();
         }
